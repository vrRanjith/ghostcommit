# Copy to .env and fill in. Never commit .env.

APP_URL=http://localhost:5173

# Generate both with: python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

# GitHub OAuth App (Settings > Developer settings > OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Backboard (Settings > API Keys). Add your OpenRouter key in Backboard's BYOK settings.
BACKBOARD_API_KEY=
LLM_PROVIDER=openrouter
MODEL_NAME=meta-llama/llama-3.3-70b-instruct

# Production email (leave empty locally; Mailpit catches mail instead)
RESEND_API_KEY=
EMAIL_FROM=GhostCommit <ghost@buildloop.tech>
